{
  "title": "Legal RAG Pipeline",
  "uid": "legal-rag",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "RAG End-to-End Latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_e2e_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_e2e_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_e2e_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval vs Rerank vs Generation Latency (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Retrieval p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_rerank_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Rerank p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_generation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Generation p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Per-Node Latency (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_node_latency_seconds_bucket[5m])) by (le, node_name))",
          "legendFormat": "{{node_name}} p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rag_cache_hits_total[5m])) by (layer)",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query Cost (USD)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_query_cost_dollars_bucket[5m])) by (le))",
          "legendFormat": "Avg Cost p50"
        },
        {
          "expr": "increase(rag_cache_savings_dollars_total[1h])",
          "legendFormat": "Cache Savings (1h)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rag_total_tokens_total{type=\"input\"}[5m])) * 60",
          "legendFormat": "Input tokens/min"
        },
        {
          "expr": "sum(rate(rag_total_tokens_total{type=\"output\"}[5m])) * 60",
          "legendFormat": "Output tokens/min"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors by Stage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rag_errors_total[5m])) by (stage)",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" }
}
